DATABASE_URL=postgres://user:pass@localhost:5432/side_a
PORT=3000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
LOG_LEVEL=info
TIX_AFRICA_EVENT_ID=side-a-04
TIX_AFRICA_EVENT_URL=https://tix.africa/event/side-a-04
MONNIFY_PAYMENT_BASE_URL=https://pay.monnify.com/...
GOOGLE_CLIENT_ID=
SERVE_WEB=false
# Optional override for the built frontend dir (defaults to <repo>/web/dist when present)
# WEB_DIST=./web/dist
# Supabase pooler (PgBouncer, port 6543) rejects prepared statements — set false there.
# Leave true/unset for direct Postgres (local dev, Supabase direct on 5432).
PG_PREPARE=true
